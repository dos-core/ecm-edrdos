;    ENDLOG
;   09-Nov-88 made RETF conditional for MASM 5.1/TASM 1.0

FALSE	equ	0
TRUE	equ	(~ FALSE)


%macro jmps 1.nolist
	jmp	short %1
%endmacro

%macro pushx 0-*.nolist
 %rep %0
	push %1
	%rotate 1
 %endrep
%endmacro

%macro popx 0-*.nolist
 %rep %0
	pop %1
	%rotate 1
 %endrep
%endmacro

%macro incx 0-*.nolist
 %rep %0
	inc %1
	%rotate 1
 %endrep
%endmacro

%macro decx 0-*.nolist
 %rep %0
	dec %1
	%rotate 1
 %endrep
%endmacro

%macro rb 1.nolist
	db %1 dup (?)
%endmacro

%macro rw 1.nolist
	dw %1 dup (?)
%endmacro

%macro rd 1.nolist
	dd %1 dup (?)
%endmacro
