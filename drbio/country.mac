US_DATE		equ	0		; American Date Format mm/dd/yy
EURO_DATE	equ	1		; European Date Format dd/mm/yy
JAP_DATE	equ	2		; Japanese Date Format yy/mm/dd

CLOCK_12	equ	0		; 12 Hour Clock Time Format
CLOCK_24	equ	1		; 24 Hour Clock Time Format

labelsize CI_CODE, word, 0FFFCh		; Country Code
labelsize CI_CODEPAGE, word, 0FFFEh		; Code page
labelsize CI_DATEFMT, word, 0		; Date Format
labelsize CI_CURRENCY, byte, 2		; Currency Symbols
labelsize CI_THOUSANDS, byte, 7		; Thousands Separator
labelsize CI_DECIMAL, byte, 9		; Decimal Separator
labelsize CI_DATESEP, byte, 11		; Date Separator
labelsize CI_TIMESEP, byte, 13		; Time Separator
labelsize CI_CURFMT, byte, 15		; Currency Format
labelsize CI_CURDIGITS, byte, 16		; Significant Currency Digits
labelsize CI_TIMEFMT, byte, 17		; Time Format
labelsize CI_CASEOFF, word, 18		; Case Translation Offset
labelsize CI_CASESEG, word, 20		; Case Translation Segment
labelsize CI_DATASEP, byte, 22		; Data List Separator
CI_STATICLEN	equ	24			; Static Country Data Length
CI_LENGTH	equ	32			; Total Country Data Length

labelsize EXI_ID, byte, 0		; Information ID
labelsize EXI_TBLOFF, word, 1		; Table Offset
labelsize EXI_TBLSEG, word, 3		; Table Segment

labelsize EXI_ID1, byte, 0		; 6501 Info ID (why move it?!)
labelsize EXI_LENGTH, word, 1		; 6501 Table Length
EXI_DATA_LEN	equ	3			; 6501 Country Data

labelsize EXCI_CUR_COUNTRY, word, 0		; Current Country
labelsize EXCI_CUR_CP, word, 2		; Current Codepage
EXCI_CI_DATAOFF	equ	4			; Start of CI_ data

EXCI_STATLEN	equ	CI_STATICLEN+4			; Static Ext Country Info
EXCI_MAXLEN	equ	EXCI_STATLEN+10+EXI_DATA_LEN	; Max Ext Country Info

