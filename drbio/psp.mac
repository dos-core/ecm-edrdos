;			 Program Segment Prefix
;			 ----------------------
;	This structure holds vital information for DOS programs
;
;*******************************************************************************
;*
;*		+-----+-----+-----+-----+-----+-----+-----+-----+
;*	   00	|  int 20   |  memory	| *** | jmpf|longjmp off|
;*		+-----+-----+-----+-----+-----+-----+-----+-----+
;*	   08	|longjmp seg| int22 Off | int22 Seg | int22 Off |
;*		+-----+-----+-----+-----+-----+-----+-----+-----+
;*	   10	| int22 Seg | int24 Off | int24 Seg |   Parent  |
;*		+-----+-----+-----+-----+-----+-----+-----+-----+
;*	   18	|		Default Handle Table		|
;*		+-----+-----+-----+-----+-----+-----+-----+-----+
;*	   20	|		  XFT (20 entries)		|
;*		+-----+-----+-----+-----+-----+-----+-----+-----+
;*	   28	|       XFT contd.	|  Environ  |  User SP	|
;*		+-----+-----+-----+-----+-----+-----+-----+-----+
;*	   30	|  User SS  |  xfnmax 	|  xftoff   |  xftseg   |
;*		+-----+-----+-----+-----+-----+-----+-----+-----+
;*	   38	|    res1   |    res2	| ric | *** | ********* |
;*		+-----+-----+-----+-----+-----+-----+-----+-----+
;*	   40	|  version  | ********* | ********* | ********* |
;*		+-----+-----+-----+-----+-----+-----+-----+-----+
;*	   48	| ********* | ********* | ********* | ********* |
;*		+-----+-----+-----+-----+-----+-----+-----+-----+
;*	   50	|  int 21   | retf| *** | ********* | ********* |
;*		+-----+-----+-----+-----+-----+-----+-----+-----+
;*	   58	| ********* | ********* |       PSP fcb 1       |
;*		+-----+-----+-----+-----+-----+-----+-----+-----+

labelsize PSP_INT20, word, 0000h
labelsize PSP_MEMORY, word, 0002h
;PSP_???	equ	byte ptr 0004h
labelsize PSP_LONGCALL, byte, 0005h
labelsize PSP_LONGOFF, word, 0006h
labelsize PSP_LONGSEG, word, 0008h
labelsize PSP_TERM_IP, word, 000Ah
labelsize PSP_TERM_CS, word, 000Ch
labelsize PSP_BREAK_IP, word, 000Eh
labelsize PSP_BREAK_CS, word, 0010h
labelsize PSP_ERROR_IP, word, 0012h
labelsize PSP_ERROR_CS, word, 0014h
labelsize PSP_PARENT, word, 0016h
labelsize PSP_XFT, byte, 0018h
;
;	The Default Handle Table is HERE !!
;
labelsize PSP_ENVIRON, word, 002ch
labelsize PSP_USERSP, word, 002eh
labelsize PSP_USERSS, word, 0030h
labelsize PSP_XFNMAX, word, 0032h
labelsize PSP_XFTPTR, dword, 0034h
labelsize PSP_XFTOFF, word, 0034h
labelsize PSP_XFTSEG, word, 0036h
labelsize PSP_RES1, word, 0038h	; DOS Reserved 0FFFFh
labelsize PSP_RES2, word, 003Ah	; DOS Reserved 0FFFFh
labelsize PSP_RIC, byte, 003Ch	; Return Interim Character flag
labelsize PSP_VERSION, word, 0040h	; DOS version number


labelsize PSP_DOSCALL, word, 0050h
labelsize PSP_DOSRETF, byte, 0052h

labelsize PSP_FCB1, byte, 005Ch
labelsize PSP_FCB2, byte, 006Ch
labelsize PSP_COMLEN, byte, 0080h
labelsize PSP_COMLINE, byte, 0081h

XFNMAX		equ	20

PSPLEN		equ	100h
PSPILEN		equ	60h
