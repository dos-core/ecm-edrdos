;    ENDLOG
;
;		   Structure of Buffer Control Blocks
;		   ----------------------------------
;	These BCBs immediately preceed the data buffers. BCBs are
;	always  shared  for all drives and therefore  must be big
;	enough for the largest drive.
;

labelsize BCB_NEXT, word, 00h	; link to next buffer
labelsize BCB_PREV, word, 02h	; link to previous buffer
labelsize BCB_DRV, byte, 04h	; drive of this buffer or 0FFh
labelsize BCB_FLAGS, byte, 05h	; buffer flags
labelsize BCB_REC, word, 06h	; low 16 bits of sector address
labelsize BCB_REC2, word, 08h	; top 16 bits of sector address
;BCB_REC2	equ	byte ptr  08h	; top 8 bits of record address
labelsize BCB_COPIES, byte, 0Ah	; number of copies to write
labelsize BCB_SEPARATION, word, 0Bh	; # sectors copies are apart
labelsize BCB_DDSC, dword, 0Dh	; DWORD ptr to DDSC_
labelsize BCB_REMOTE, word, 11h	; remote in-use count
labelsize BCB_DATA, byte, 14h	; buffer data

BF_ISFAT	equ	0002h		; buffer marked as FAT sector
BF_ISDIR	equ	0004h		; buffer marked as Directory sector
BF_ISDAT	equ	0008h		; buffer marked as Data sector
BF_DIRTY	equ	0040h		; buffer marked as modified
BF_REMOTE	equ	0080h		; buffer is remote

MAX12		equ	0FF6h		; max. disk size w/ 12-bit media

;		     Structure of Hash Control Block
;		     -------------------------------
;	Each hash control  block refers  to the hash codes of one
;	disrectory cluster or a root directory.

labelsize HCB_LINK, word, 0	; link to next control block
labelsize HCB_DRV, byte, 2	; drive for this entry or 0FFh
labelsize HCB_CLU, word, 4	; cluster number or 0000 if root
labelsize HCB_CLUH, word, 6	; high word of cluster number
labelsize HCB_CNT, word, 8	; number of hashed entries
labelsize HCB_DATA, word, 10	; hash buffer data


;		      Structure of DOS FCB
;		      --------------------
;	This is hopefully  consistent  with what DOS stores in an
;	open file control block for DOS 1.x functions

labelsize MSF_EXTFLG, byte, 0	; if this is 0xFF, skip 1st 7 byte
labelsize MSF_ATTRIB, byte, 6	; file attributes if MSF_EXTFLG
labelsize MSF_DRIVE, byte, 0	; 1st byte normally drive code
labelsize MSF_NAME, byte, 1	; 8-bit ASCII file name, 11 characters
labelsize MSF_BLOCK, word, 12	; current block number
labelsize MSF_RECSIZE, word, 14	; current logical record size
labelsize MSF_SIZE, word, 16	; 32-bit file size
labelsize MSF_DATE, word, 20	; last date stamp
labelsize MSF_TIME, word, 22	; last time stamp
labelsize MSF_IFN, byte, 24	;; internal file number
labelsize MSF_IOCTL, byte, 25	;; file status
labelsize MSF_BLOCK1, word, 26	;; 1st block of file
labelsize MSF_DBLK, word, 28	;; directory block
labelsize MSF_DEVPTR, dword, 28	;; address of device driver
labelsize MSF_DCNT, word, 30	;; directory count
labelsize MSF_CR, byte, 32	; current sequential record
labelsize MSF_RR, word, 33	; random record address (3 or 4 byte)
labelsize MSF_RR2, byte, 35	; random record overflow


;		      Structure of DOS DPB
;		      --------------------
;	The  layout  of  this  structure  is  a  guess  based  on
;	examples.  It is returned by PC MODE on functions 1Fh and
;	32h  and is required  by various  disk-related  utilities
;	like disk editors and CHKDSK.

labelsize DDSC_UNIT, byte, 0		; absolute drive number
labelsize DDSC_RUNIT, byte, 1		; relative unit number
labelsize DDSC_SECSIZE, word, 2		; sector size in bytes
labelsize DDSC_CLMSK, byte, 4		; sectors/cluster - 1
labelsize DDSC_CLSHF, byte, 5		; log2 (sectors/cluster)
labelsize DDSC_FATADDR, word, 6		; sector address of FAT
labelsize DDSC_NFATS, byte, 8		; # of FAT copies
labelsize DDSC_DIRENT, word, 9		; size of root directory
labelsize DDSC_DATADDR, word, 11		; sector address of cluster #2
labelsize DDSC_NCLSTRS, word, 13		; # of clusters on disk
labelsize DDSC_NFATRECS, word, 15		; # of sectors per FAT
labelsize DDSC_DIRADDR, word, 17		; sector address of root dir
labelsize DDSC_DEVHEAD, dword, 19		; device driver header
labelsize DDSC_DEVOFF, word, 19
labelsize DDSC_DEVSEG, word, 21
labelsize DDSC_MEDIA, byte, 23		; current media byte
labelsize DDSC_FIRST, byte, 24		; "drive never accessed" flag
labelsize DDSC_LINK, dword, 25		; next drive's DDSC
labelsize DDSC_BLOCK, word, 29		; next block to allocate
labelsize DDSC_FREE, word, 31		; total free clusters on drive
labelsize DDSC_BFREE, dword, 33		; total free clusters on drive (32-bit)
labelsize DDSC_FSFLAGS, word, 37		; FAT mirroring flags
labelsize DDSC_FSINFO, word, 39		; sector number of file system info block
labelsize DDSC_BOOTBAK, word, 41		; sector number of backup boot sector
labelsize DDSC_BDATADDR, dword, 43		; sector address of cluster #2 (32-bit)
labelsize DDSC_BCLSTRS, dword, 47		; # of clusters on disk (32-bit)
labelsize DDSC_BFATRECS, dword, 51		; # of sectors per FAT (32-bit)
labelsize DDSC_FSROOT, dword, 55		; starting cluster of root directory
labelsize DDSC_BBLOCK, dword, 59		; next block to allocate (32-bit)
labelsize DDSC_FSVER, word, 63		; version of file system
DDSC_LEN	equ	65



;		DELWATCH hooks called by OS

DELW_RDMASK	equ	0			; delete dir search mask
DELW_DELETE	equ	2			; delete this dir entry
DELW_FREECLU	equ	3			; free some clusters
DELW_FREERD	equ	4			; free root dir entry
DELW_SPACE	equ	5			; add "deletes" to free space
DELW_NEWDISK	equ	7			; new disk logged in
DELW_PURGE	equ	14			; perge pd file
DELW_UNDEL	equ	15			; undelete pd file

; 		SuperStore hook called by OS

SSTOR_SPACE	equ	10h			; enquire # physical free space

;		Password hooks called by OS

PASSWD_CREAT	equ	20h			; initialise an entry
PASSWD_CHMOD	equ	21h			; change an entry
PASSWD_CHECK	equ	22h			; check an entry

;	Share hooks in PCMODE data segment
;
; These point to a stub which does a "STC, RETF"
;

NUM_SHARE_STUB_ENTRIES	equ	15

S_LOCKS		equ	4*0		; share lock/unlock region
S_UPDATE	equ	4*1		; update DHNDL from share
S_RECORD	equ	4*2		; update share from DHNDL
S_FDOSRW	equ	4*3		; validate proposed operation
S_DISCARD	equ	4*4		; discard all files on drive
S_OPEN		equ	4*5		; files is opening, remember it
S_CLOSE		equ	4*6		; files is closing, forget it
S_OM_COMPAT	equ	4*7		; check open mode compatible
S_CLOSE_IF_OPEN	equ	4*8		; close if compat open, else deny
S_DENY_IF_OPEN	equ	4*9		; deny if open shared/by others
S_GET_LIST_ENTRY equ	4*10	; get open file list entry
S_CLOSE_FILES	equ	4*11	; close all files for given PSP/UID

; struct dirfcb

labelsize DNAME, byte, 0	;file name & type
labelsize DATTS, byte, 11 
  DA_RO		equ	01h		; 0x01 - read/only
  DA_HIDDEN	equ	02h		; 0x02 - hidden
  DA_SYSTEM	equ	04h		; 0x04 - system
  DA_VOLUME	equ	08h		; 0x08 - volume label
  DA_DIR	equ	10h		; 0x10 - sub-directory
  DA_ARCHIVE	equ	20h		; 0x20 - archive
  DA_CLUSTER	equ	80h		; 0x80 - return starting cluster from search (API extention)
  DA_DELWATCH	equ	80h		; 0x88 - return pending delete files
  DA_FIXED	equ	11011000b	; can't CHMOD label, dir, unused bits
  DA_CHANGE	equ	~ DA_FIXED	; all others are changeable
  DA_LFN	equ	DA_RO+DA_HIDDEN+DA_SYSTEM+DA_VOLUME

;DATTS2		equ	12		;CP/M attributes
;					; 0x80 - f1' modify default open rules
;					; 0x40 - f2' partial close default
;					; 0x20 - f3' ignore close checksum errors
;					; 0x10 - f4' disable checksums
;					; 0x08 - (reserved)
;					; 0x04 - DELETE password
;					; 0x02 - WRITE password
;					; 0x01 - READ password
DSIZEX		equ	12		;file size extension for FAT+ (bit 0-2 and 5-7)
DUNDEL		equ	13		;1st letter of deleted file
labelsize DPWD, word, 14	;16-bit password hash code
labelsize DMODTIME, word, 16	;delwatch time (hhhhhmmmmmmsssss)
labelsize DMODDATE, word, 18	;delwatch date (yyyyyyymmmmddddd)
;DRECSIZE	equ	16		;FlexOS record size
;DUSER		equ	18		;FlexOS user ID of creator
;DGROUP		equ	19		;FlexOS group ID of creator
labelsize DPWM, word, 20	;FlexOS access rights
labelsize DBLOCK1H, word, 20	;high word of first block in file
DTIME		equ	22		;time (hhhhhmmmmmmsssss)
DDATE		equ	24		;date (yyyyyyymmmmddddd)
DBLOCK1		equ	26		;first block in file
DSIZE		equ	28		;current file size

;		 DOS Media Password Definitions
;		 ------------------------------

PWM_OWNER	equ	000Fh			; PWD Owner mask
PWM_GROUP	equ	00F0h			; PWD Group mask
PWM_WORLD	equ	0F00h			; PWD World mask
PWM_R		equ	0888h			; PWD required for reading
PWM_W		equ	0444h			; PWD required for writing
PWM_E		equ	0222h			; PWD req'd for executing
PWM_D		equ	0111h			; PWD required for deleting
PWM_ANY		equ	PWM_R+PWM_W+PWM_D	; PWD required for anything


;	literal constants

FAT12		equ	00fffh		; 12 bit fat
FAT16		equ	0ffffh		; 16 bit fat
FAT32		equ	0		; 32 bit fat

ENDDIR		equ	0ffffh		;end of directory

FS_BFREE	equ	1e8h		; free cluster offset in FS info block
FS_BBLOCK	equ	1ech		; next block offset in FS info block
