labelsize FREED_SIZE, word, 00h	; size of structure
labelsize FREED_VER, word, 02h	; version of structure
labelsize FREED_SECPCLUS, dword, 04h	; sectors per cluster
labelsize FREED_BYTEPSEC, dword, 08h	; bytes per sector
labelsize FREED_FREECL, dword, 0ch	; available clusters
labelsize FREED_NCLUSTER, dword, 10h	; number of clusters on drive
labelsize FREED_FREESEC, dword, 14h	; number of physical sectors available on drive
labelsize FREED_NSECS, dword, 18h	; number of physical sectors on drive
labelsize FREED_FREEPCL, dword, 1ch	; available physical allocation units
labelsize FREED_NPCLUS, dword, 20h	; number of physical allocation units
;FREED_RESERVED	equ	24h		; reserved bytes
FREED_LEN	equ	24h		; length of data

labelsize EDPB_DEVHEAD, dword, 13h	; device driver header
labelsize EDPB_DPBFLAGS, byte, 18h	; DPB flags (undocumented)
labelsize EDPB_LINK, dword, 19h	; link to next DPB
labelsize EDPB_FSINFO, word, 25h	; file system info sector
labelsize EDPB_BOOTBAK, word, 27h	; backup of boot sector
labelsize EDPB_BDATADDR, dword, 29h	; sector address of cluster #2
labelsize EDPB_BCLSTRS, dword, 2dh	; highest cluster number
labelsize EDPB_BFATRECS, dword, 31h	; number of sectors per FAT
labelsize EDPB_BBLOCK, dword, 39h	; next block to allocate
EDPB_LEN	equ	3dh		; length of Extended DPB structure
