;
;    ENDLOG
;	The following equates define the Data Area whose address is
;	returned by function 52.
;

labelsize F52_BCBBUF, dword, -0008h		; current buffer
labelsize F52_BCBOFF, word, -0008h		; current buffer
labelsize F52_BCBSEG, word, -0006h		; current buffer
labelsize F52_DMDROOT, word, -0002h		; Memory Descriptor Root (Seg)
labelsize F52_DDSCPTR, dword, 0000h		; DDSC Table Address
labelsize F52_FILEPTR, dword, 0004h		; File Handle Table Address
labelsize F52_CLKDEV, dword, 0008h		; Clock Device Header
labelsize F52_CONDEV, dword, 000Ch		; Console Device Header
labelsize F52_SECSIZE, word, 0010h		; Maximum Sector Size
labelsize F52_BUFINFOPTR, dword, 0012h		; Buffer Info pointer
labelsize F52_PATHPTR, dword, 0016h		; Path Control Table Address
labelsize F52_PATHOFF, word, 0016h
labelsize F52_PATHSEG, word, 0018h
labelsize F52_FCBPTR, dword, 001Ah		; FCB Table Address
;		equ	word ptr  001Eh		; #Entries in FCB Table
labelsize F52_PHYDRV, byte, 0020h		; Last Physical Drive
labelsize F52_LASTDRV, byte, 0021h		; Last Logical Drive
labelsize F52_DEVROOT, dword, 0022h		; Root Device Header
labelsize F52_JOINDRV, byte, 0034h		; Number of JOIN'd drives
labelsize F52_SETVER, dword, 0037h		; SETVER table pointer
labelsize F52_NUM_BUF, word, 003Fh		; number of disk buffers
labelsize F52_READ_AHEAD, word, 0041h		; size of read-ahead buffer
labelsize F52_BOOTDRV, byte, 0043h		; boot drive (1-26)
labelsize F52_CPU_TYPE, byte, 0044h		; 01 if >= 386SX
labelsize F52_EXT_MEM, word, 0045h		; Int 15h, AH=87h
labelsize F52_BUF_INFO, dword, 0047h		; points at Buffer Info
labelsize F52_HMAFLAG, byte, 0053h		; 1 if buffers in HMA
labelsize F52_DEBLOCK, word, 0056h		; deblock if buffers in HMA
labelsize F52_DMD_UPPER, word, 0066h		; upper memory chain
labelsize F52_SHARE_STUB, dword, 006Ah		; Share Stub Entries*15

;DRDOS Specific

labelsize DRDOS_CRITSTUBS, word, 0000h		; Offset of end of instance data
labelsize DRDOS_HIST1CTL, word, 0004h		; History 1 Control
labelsize DRDOS_HIST2CTL, word, 0006h		; History 2 Control
labelsize DRDOS_HISTFLG, byte, 0008h		; History Buffer Flag 
labelsize DRDOS_DUAL_LANG, byte, 0009h		; Utils Dual Language Support
labelsize DRDOS_CUR_LANG, byte, 000Ah		; Current Language
labelsize DRDOS_EXT_MEM, word, 000Bh		; Total Extended Memory
labelsize DRDOS_HIMEM_ROOT, word, 0010h		; High memory chain
labelsize DRDOS_ENVSEG, word, 0012h		; Seg of environment
labelsize DRDOS_DMD_BASE, word, 0016h		; base memory freed at
labelsize DRDOS_DMD_UPPER, word, 0018h		; upper memory chain
labelsize DRDOS_MACHINE_ID, word, 001Ah		; local machine ID
labelsize DRDOS_COUNTRY_FILE, word, 001Eh		; offset of filename
labelsize DRDOS_HASHOFF, word, 0020h		; fastopen hash root
labelsize DRDOS_HASHSEG, word, 0022h		;  pointer
labelsize DRDOS_HASHMAX, word, 0024h		; max # dir entries
labelsize DRDOS_DEBLOCK, word, 0026h		; himem deblock buffer
labelsize DRDOS_INT2F, word, 002Ch		; internal Int 2F hook
