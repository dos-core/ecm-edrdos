labelsize DCNTRL_DSADD, dword, 0000h  
labelsize DCNTRL_DSOFF, word, 0000h  
labelsize DCNTRL_DSSEG, word, 0002h  
labelsize DCNTRL_COUNT, word, 0004h  
DCNTRL_LEN	equ	6

labelsize DHNDL_COUNT, word, 00h		; 00 - Usage Count
labelsize DHNDL_MODE, word, 02h		; 02 - File Mode

DHM_FCB		equ	8000h			; marks as FCB
DHM_COMMIT	equ	4000h			; auto-commit file
DHM_NOCRIT	equ	2000h			; no critical errors
DHM_LOCAL	equ	10000000b		; file is not inherited
DHM_SHAREMSK	equ	01110000b		; sharing bits
DHM_COMPAT	equ	00000000b
DHM_DENY_ALL	equ	00010000b		; exclusive - deny all
DHM_DENY_WRITE	equ	00100000b
DHM_DENY_READ	equ	00110000b
DHM_DENY_NONE	equ	01000000b
DHM_RWMSK	equ	00001111b		; read write bits
DHM_RW		equ	00000010b		; file opened read/write
DHM_WO		equ	00000001b		; file opened write only
DHM_RO		equ	00000000b		; file opened read only

;
;	01h to 03h To be Determined
;
labelsize DHNDL_DATRB, byte, 04h		; Disk attribute byte
labelsize DHNDL_ATTR, byte, 05h		; Attribute Byte
labelsize DHNDL_WATTR, word, 05h		; Attribute Word

DHAT_REMOTE	equ	8000h			; set if file remote
DHAT_TIMEOK	equ	4000h			; set if timestamp up to date
DHAT_LOCAL	equ	1000h			; file is not inherited
DHAT_NETPRN	equ	0800h			; device is networked printer
DHAT_DEV	equ	0080h			; device/file bit
DHAT_READY	equ	0040h			; ready/not ready bit
DHAT_CLEAN	equ	0040h			; this bit CLEAR if dirty
DHAT_BIN	equ	0020h			; raw/cooked bit
DHAT_DRVMSK	equ	001Fh			; drive in bottom bits
DHAT_CLK	equ	0008h			; -reserved-
DHAT_NUL	equ	0004h			; handle is null device
DHAT_COT	equ	0002h			; handle is console output device
DHAT_CIN	equ	0001h			; handle is console input device

labelsize DHNDL_DEVPTR, dword, 07h		; 07 - pointer to device
labelsize DHNDL_DEVOFF, word, 07h		; 07 - offset of device
labelsize DHNDL_DEVSEG, word, 09h		; 09 - segment of device
labelsize DHNDL_BLK1, word, 0Bh		; 0B - first cluster in file
						;      (lower 32 bits)
labelsize DHNDL_TIME, word, 0Dh		; 0D - file time stamp
labelsize DHNDL_DATE, word, 0Fh		; 0F - file date stamp
labelsize DHNDL_SIZE, dword, 11h		; 11 - file length
						;      (lower 32 bits)
labelsize DHNDL_SIZELO, word, 11h
labelsize DHNDL_SIZEHI, word, 13h
labelsize DHNDL_POS, dword, 15h		; 15 - current file position
						;      (lower 32 bits)
labelsize DHNDL_POSLO, word, 15h
labelsize DHNDL_POSHI, word, 17h
labelsize DHNDL_IDX, word, 19h		; 19 - relative cluster within file of last read
						;      (lower 32 bits)
labelsize DHNDL_DBLK, word, 1Bh		; 1B - cluster # of dir entry
						;      (lower 32 bits)
labelsize DHNDL_DCNTHI, byte, 1Eh		; 1E - dir offset # within cluster
labelsize DHNDL_DCNTLO, byte, 1Fh		; 1F - dir offset # within cluster
labelsize DHNDL_NAME, byte, 20h		; 20 - File/Device Name
labelsize DHNDL_EXT, byte, 28h		; 28 - File extension
labelsize DHNDL_SFT, dword, 2Bh		; 2B - pointer to previous SFT
labelsize DHNDL_UID, word, 2Fh		; 2F - Owning Machine ID
labelsize DHNDL_PSP, word, 31h		; 31 - Owning PSP
labelsize DHNDL_SHARE, word, 33h		; 33 - Offset of sharing record
labelsize DHNDL_BLK, word, 35h		; 35 - absolute cluster of last read
						;      (lower 32 bits)
						; 37 - dword reserved for IFS
labelsize DHNDL_BLK1H, word, 3Bh		; 3B - first cluster in file
						;      (higher 32 bits)
labelsize DHNDL_IDXH, word, 3Dh		; 3D - relative cluster within file of last read
						;      (higher 32 bits)
labelsize DHNDL_DBLKH, word, 3Fh		; 3F - cluster # of dir entry
						;      (higher 32 bits)
labelsize DHNDL_BLKH, word, 41h		; 41 - absolute cluster of last read
						;      (higher 32 bits)
labelsize DHNDL_SIZEX, dword, 43h		; 43 - file length
						;      (higher 32 bits)
labelsize DHNDL_SIZEXLO, word, 43h
labelsize DHNDL_SIZEXHI, word, 45h
labelsize DHNDL_POSX, dword, 47h		; 47 - current file position
						;      (higher 32 bits)
labelsize DHNDL_POSXLO, word, 47h
labelsize DHNDL_POSXHI, word, 49h
DHNDL_LEN	equ	4Bh

; With DOS 3 structures _DBLK is a 16 bit


; Logical Drive Table format
labelsize LDT_NAME, byte, 00h		; 00 - Ascii Name field
labelsize LDT_FLAGS, word, 43h		; 43 - Flag field
labelsize LDT_PDT, dword, 45h		; 45 - PDT for this drive
labelsize LDT_BLK, word, 49h		; 49 - directory sector 
labelsize LDT_ROOT, word, 4bh		; 4B - virtual block root
labelsize LDT_DRV, byte, 4dh		; 4D - physical drive 
labelsize LDT_ROOTLEN, word, 4fh		; 4F - Length of root portion
labelsize LDT_BLKH, word, 51h
labelsize LDT_ROOTH, word, 53h
LDT_LEN		equ	58h

LFLG_NETWRKD	equ	8000h
LFLG_PHYSICAL	equ	4000h
LFLG_JOINED	equ	2000h
LFLG_SUBST	equ	1000h
