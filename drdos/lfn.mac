; LFN.EQU - Definitions for Long Filename and 64-bit file size support
;
; This file is part of
; The DR-DOS/OpenDOS Enhancement Project - http://www.drdosprojects.de
; Copyright (c) 2002-2006 Udo Kuhnt

labelsize FINFO_ATTR, dword, 00h	; file attributes
labelsize FINFO_CREAT_T, dword, 04h	; creation time (64-bit)
labelsize FINFO_ACCESS_T, dword, 0ch	; last access time (64-bit)
labelsize FINFO_WRITE_T, dword, 14h	; last write time (64-bit)
labelsize FINFO_SERNUM, dword, 1ch	; volume serial number
labelsize FINFO_SIZEH, dword, 20h	; file size (higher 32 bits)
labelsize FINFO_SIZE, dword, 24h	; file size (lower 32 bits)
labelsize FINFO_LINKS, dword, 28h	; number of links to file
labelsize FINFO_IDH, dword, 2ch	; file identifier (higher 32 bits)
labelsize FINFO_ID, dword, 30h	; file identifier (lower 32 bits)
FINFO_LEN	equ	34h		; length of Get File Info structure
